		protected override void OnStateChange()
		{
			if (State == State.SetDefaults)
			{
				Description					= NinjaTrader.Custom.Resource.NinjaScriptIndicatorDescriptionVolumeProfile;
				Name						= "MyProfile";
				Calculate					= Calculate.OnEachTick;
				
				IsChartOnly					= true;
				IsOverlay					= true;
				DrawOnPricePanel			= false;
				
				
			}
			else if (State == State.Configure)
			{
				if (typetimeframe==typeoftimeframeenum.Minutes)
					AddDataSeries(Instrument.FullName, BarsPeriodType.Minute, timeframe);
				
				if (typetimeframe==typeoftimeframeenum.Hours)
					AddDataSeries(Instrument.FullName, BarsPeriodType.Minute, timeframe*60);
			}
			else if (State == State.DataLoaded)
			{
				storedSession = new SessionIterator(Bars);
			}
			else if (State == State.Historical)
			{
				if (Calculate != Calculate.OnEachTick)
					Draw.TextFixed(this, "NinjaScriptInfo", string.Format(NinjaTrader.Custom.Resource.NinjaScriptOnBarCloseError, Name), TextPosition.BottomRight);
			}
		}

