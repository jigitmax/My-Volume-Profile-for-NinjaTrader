		private DateTime GetLastBarSessionDate(DateTime time)
		{
			if (time <= cacheSessionEnd)
				return sessionDateTmp;
			
			//if (!Bars.BarsType.IsIntraday)
				//return sessionDateTmp;
			//if (CurrentBars[1] <= BarsRequiredToPlot)
        	//return sessionDateTmp;
			if (BarsInProgress == 1)
				if(IsFirstTickOfBar)
					cacheSessionEnd= Time[0];
			sessionDateTmp=cacheSessionEnd;
		
			
			if(newSessionBarIdx.Count == 0 || newSessionBarIdx.Count > 0 && CurrentBar > newSessionBarIdx[newSessionBarIdx.Count - 1])
				newSessionBarIdx.Add(CurrentBar);

			return sessionDateTmp;
		}

		protected override void OnMarketData(MarketDataEventArgs e)
		{
			if (Bars.Count <= 0)
				return;
			
		
			double			price;
			long			volume;
			VolumeInfoItem	volumeInfoItem;
			DateTime		lastBarTimeStamp =GetLastBarSessionDate(Time[0]);
			
			if (lastBarTimeStamp != currentDate)
			{
				cacheDictionary = new Dictionary<double, VolumeInfoItem>();
				sortedDicList.Add(cacheDictionary);
			}
			currentDate = lastBarTimeStamp;
			if (Bars.IsTickReplay)
			{
				if (e.MarketDataType == MarketDataType.Last)
				{
					price	= e.Price;
					volume	= e.Volume;

					if (!cacheDictionary.ContainsKey(price))
						cacheDictionary.Add(price, new VolumeInfoItem());

					volumeInfoItem = cacheDictionary[price];

					
						volumeInfoItem.up		+= volume;
					
				}
			}
			else
			{
				if (e.MarketDataType == MarketDataType.Ask)
				{
					askPrice = e.Price;
					return;
				}

				if (e.MarketDataType == MarketDataType.Bid)
				{
					bidPrice = e.Price;
					return;
				}

				if (e.MarketDataType != MarketDataType.Last || ChartControl == null || askPrice == 0 || bidPrice == 0)
					return;

				if (Bars != null && !SessionIterator.IsInSession(Core.Globals.Now, true, true))
					return;

				price	= e.Price;
				volume	= e.Volume;

				if (!cacheDictionary.ContainsKey(price))
					cacheDictionary.Add(price, new VolumeInfoItem());

				volumeInfoItem = cacheDictionary[price];

				
					volumeInfoItem.up		+= volume;
				
			}

			
			
		}

		protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
		{
			if(Bars == null || Bars.Instrument == null || IsInHitTest)
				return;

			int		firstBarIdxToPaint	= -1;
			double	tickSize			= Bars.Instrument.MasterInstrument.TickSize;
			double	volumeMax			= 0;
			int howmuch=0;
			Dictionary<int,int> yprofilepos = new Dictionary<int, int>();
			int pocv=0;
			
			
			SharpDX.Direct2D1.AntialiasMode oldAntialiasMode = RenderTarget.AntialiasMode;
			RenderTarget.AntialiasMode = SharpDX.Direct2D1.AntialiasMode.PerPrimitive;

			
			SharpDX.Color3 dxColor3=new SharpDX.Color3(0.0f,0.5f,1.0f);
			SharpDX.Color4 dxColor4=new SharpDX.Color4(dxColor3,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4);
			SharpDX.Color3 dxColor3_1=new SharpDX.Color3(0.0f,0.5f,0.5f);
			SharpDX.Color4 dxColor4_1=new SharpDX.Color4(dxColor3_1,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_1			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_1);
			SharpDX.Color3 dxColor3_2=new SharpDX.Color3(0.0f,1.0f,0.0f);
			SharpDX.Color4 dxColor4_2=new SharpDX.Color4(dxColor3_2,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_2			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_2);
			SharpDX.Color3 dxColor3_3=new SharpDX.Color3(0.0f,0.75f,0.0f);
			SharpDX.Color4 dxColor4_3=new SharpDX.Color4(dxColor3_3,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_3			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_3);
			SharpDX.Color3 dxColor3_4=new SharpDX.Color3(1.0f,1.0f,0.0f);
			SharpDX.Color4 dxColor4_4=new SharpDX.Color4(dxColor3_4,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_4			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_4);
			SharpDX.Color3 dxColor3_5=new SharpDX.Color3(1.0f,0.75f,0.0f);
			SharpDX.Color4 dxColor4_5=new SharpDX.Color4(dxColor3_5,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_5			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_5);
			SharpDX.Color3 dxColor3_6=new SharpDX.Color3(1.0f,0.5f,0.0f);
			SharpDX.Color4 dxColor4_6=new SharpDX.Color4(dxColor3_6,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_6			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_6);
			SharpDX.Color3 dxColor3_7=new SharpDX.Color3(0.75f,0.5f,0.0f);
			SharpDX.Color4 dxColor4_7=new SharpDX.Color4(dxColor3_7,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_7			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_7);
			SharpDX.Color3 dxColor3_8=new SharpDX.Color3(1.0f,0.0f,0.0f);
			SharpDX.Color4 dxColor4_8=new SharpDX.Color4(dxColor3_8,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_8			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_8);
			SharpDX.Color3 dxColor3_9=new SharpDX.Color3(0.75f,0.0f,0.0f);
			SharpDX.Color4 dxColor4_9=new SharpDX.Color4(dxColor3_9,(float)alpha*0.01f);
			SharpDX.Direct2D1.SolidColorBrush upBrush_9			= new SharpDX.Direct2D1.SolidColorBrush(RenderTarget,dxColor4_9);

			
			

			for (int i = newSessionBarIdx.Count - 1; i > 0; i--)
			{
				//if (newSessionBarIdx[i] <= ChartBars.ToIndex)
				//{
					startIndexOf		= i;
					firstBarIdxToPaint	= newSessionBarIdx[i];
				//	break;
				//}
			float	xpos				= chartControl.GetXByBarIndex(ChartBars, !Bars.IsTickReplay ? ChartBars.FromIndex : Math.Max(1, Math.Max(ChartBars.FromIndex, firstBarIdxToPaint)) - 1);
			if (xpos>chartControl.GetXByTime(chartControl.FirstTimePainted) && xpos<chartControl.GetXByTime(chartControl.LastTimePainted))
			{
			if (sortedDicList.Count < 1 && cacheDictionary.Keys.Count > 0)
				sortedDicList.Add(cacheDictionary);

			foreach (Dictionary<double, VolumeInfoItem> tmpDict in sortedDicList)
			{
				foreach (KeyValuePair<double, VolumeInfoItem> keyValue in tmpDict)
				{
					double price = keyValue.Key;

					if (Bars.BarsType.IsIntraday && (price > chartScale.MaxValue || price < chartScale.MinValue))
						continue;

					VolumeInfoItem	vii		= keyValue.Value;
					double			total	= vii.up;
					volumeMax				= Math.Max(volumeMax, total);
				}
			}

			if (volumeMax.ApproxCompare(0) == 0)
				return;

			

			foreach (KeyValuePair<double, VolumeInfoItem> keyValue in sortedDicList[startIndexOf])
			{
				
				

				VolumeInfoItem vii = keyValue.Value;

				//double	priceLower			= keyValue.Key - tickSize / 2;
				double  myprice				= keyValue.Key;
				//float	yLower				= chartScale.GetYByValue(priceLower);
				//float	yUpper				= chartScale.GetYByValue(priceLower + tickSize);
				//float	height				= Math.Max(1, Math.Abs(yUpper - yLower) - barSpacing);
				//int		barWidthUp			= (int)((ChartPanel.W / 4) * (vii.up / volumeMax));
				//float	stationaryXpos		= chartControl.GetXByBarIndex(ChartBars, !Bars.IsTickReplay ? ChartBars.FromIndex : Math.Max(ChartBars.FromIndex, firstBarIdxToPaint));
				//float	xpos				= chartControl.GetXByBarIndex(ChartBars, !Bars.IsTickReplay ? ChartBars.FromIndex : Math.Max(1, Math.Max(ChartBars.FromIndex, firstBarIdxToPaint)) - 1);
				
				if (yprofilepos.ContainsKey(chartScale.GetYByValue(myprice)))
			 		{
						if (yprofilepos[chartScale.GetYByValue(myprice)]<(int)vii.up)
							yprofilepos[chartScale.GetYByValue(myprice)]=(int)vii.up;
					}
					else
					{
						yprofilepos.Add(chartScale.GetYByValue(myprice),(int)vii.up);
					}
				pocv=Math.Max(pocv,(int)vii.up);
				//RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush);
				//xpos += barWidthUp;
				

				
			}
			
			foreach (KeyValuePair<int,int> keyValue in yprofilepos)
			{
				//xpos перемещен
				float	yUpper				= keyValue.Key;
				//int		barWidthUp			=(int)((ChartPanel.W / 4) * (keyValue.Value / (double)pocv));
				float	height				=1;
				
				int		barWidthUp			=(int)(((int)(chartControl.Properties.BarMarginRight * chartControl.Properties.BarDistance) + WidthProfile)*(keyValue.Value / (double)pocv));
				
				
				
				if (xpos>chartControl.GetXByTime(chartControl.FirstTimePainted) &&  xpos<chartControl.GetXByTime(chartControl.LastTimePainted))
				{
					if (keyValue.Value / (double)pocv>0.9f)					
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush);
					if (keyValue.Value / (double)pocv <= 0.9f & keyValue.Value / (double)pocv >0.8f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_1);
					if (keyValue.Value / (double)pocv <= 0.8f & keyValue.Value / (double)pocv >0.7f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_2);
					if (keyValue.Value / (double)pocv <= 0.7f & keyValue.Value / (double)pocv >0.6f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_3);
					if (keyValue.Value / (double)pocv <= 0.6f & keyValue.Value / (double)pocv >0.5f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_4);
					if (keyValue.Value / (double)pocv <= 0.5f & keyValue.Value / (double)pocv >0.4f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_5);
					if (keyValue.Value / (double)pocv <= 0.4f & keyValue.Value / (double)pocv >0.3f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_6);
					if (keyValue.Value / (double)pocv <= 0.3f & keyValue.Value / (double)pocv >0.2f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_7);
					if (keyValue.Value / (double)pocv <= 0.2f & keyValue.Value / (double)pocv >0.1f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_8);
					if (keyValue.Value / (double)pocv <= 0.1f)
						RenderTarget.FillRectangle(new SharpDX.RectangleF(xpos, yUpper, barWidthUp, height), upBrush_9);
				
				
				
				}
				
			}
			
			yprofilepos.Clear();
			pocv=0;
			}
			}

			
			upBrush.Dispose();
			upBrush_1.Dispose();
			upBrush_2.Dispose();
			upBrush_3.Dispose();
			upBrush_4.Dispose();	
			upBrush_5.Dispose();
			upBrush_6.Dispose();
			upBrush_7.Dispose();	
			upBrush_8.Dispose();
			upBrush_9.Dispose();
			RenderTarget.AntialiasMode = oldAntialiasMode;
			//float xxx=chartControl.Properties.BarMarginRight * chartControl.Properties.BarDistance;
			//Log(xxx.ToString(),LogLevel.Information);	
			
			
			
			}

